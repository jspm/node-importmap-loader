{
  "name": "@jspm/node-importmap-loader",
  "version": "0.2.3",
  "description": "JSPM's node importmap loader ⚡️",
  "type": "module",
  "main": "dist/loader.js",
  "types": "dist/loader.d.ts",
  "exports": {
    ".": "./dist/loader.js"
  },
  "bin": {
    "load-node-importmap": "node --loader dist/loader.js"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "author": "Jaya Krishna Namburu <namburu1995@gmail.com>",
  "homepage": "https://jspm.org/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/yowainwright/shave.git"
  },
  "contributors": [
    {
      "name": "Jeff Wainwright",
      "email": "yowainwright@gmail.com",
      "url": "https://jeffry.in"
    },
    {
      "name": "Jaya Krishna Namburu",
      "email": "namburu1995@gmail.com",
      "url": "https://github.com/JayaKrishnaNamburu"
    }
  ],
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:build": "tsup tests/*.test.ts --format esm --target node22 --out-dir dist/tests --clean --no-splitting",
    "test:unit": "npm run test:build && node --test dist/tests/*.test.js",
    "test:e2e": "chomp test:e2e",
    "dir-size": "chomp dir-size",
    "lint": "oxlint --max-warnings 0 src tests scripts",
    "lint:fix": "npm run lint -- --fix",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "hooks:install": "sh scripts/install-hooks.sh",
    "commit:check": "node scripts/check-commit-message.js"
  },
  "dependencies": {
    "@jspm/generator": "^2.5.1",
    "@jspm/import-map": "^1.1.0",
    "node-fetch": "^3.3.2"
  },
  "devDependencies": {
    "@swc/core": "^1.3.74",
    "@types/node": "^20.4.7",
    "@types/node-fetch": "^2.6.4",
    "chomp": "^0.2.17",
    "oxfmt": "0.75.0",
    "oxlint": "1.90.0",
    "tslib": "^2.6.1",
    "tsup": "^7.2.0",
    "typescript": "^5.1.6"
  },
  "license": "MIT"
}
